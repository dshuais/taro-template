{
  "name": "taro-app",
  "version": "1.0.0",
  "private": true,
  "description": "taro-app",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:weapp:test": "taro build --type weapp --mode test",
    "postinstall": "weapp-tw patch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "git add"
    ]
  },
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.21.5",
    "@nutui/nutui-react-taro": "^3.0.11",
    "@spacego/classnames": "^1.0.0",
    "@spacego/is": "^1.0.1",
    "@spacego/taro-components": "0.0.1-alpha.3",
    "@spacego/tools-taro": "^1.0.0",
    "@spacego/turbo-utils": "^1.0.0",
    "@tarojs/components": "3.6.34",
    "@tarojs/helper": "3.6.34",
    "@tarojs/plugin-framework-react": "3.6.34",
    "@tarojs/plugin-html": "3.6.34",
    "@tarojs/plugin-http": "3.6.34",
    "@tarojs/plugin-platform-weapp": "3.6.34",
    "@tarojs/react": "3.6.34",
    "@tarojs/runtime": "3.6.34",
    "@tarojs/shared": "3.6.34",
    "@tarojs/taro": "3.6.34",
    "ahooks": "^3.8.0",
    "axios": "^1.7.2",
    "dayjs": "^1.11.12",
    "lodash-es": "^4.17.21",
    "qs": "^6.12.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.8.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "3.6.34",
    "@tarojs/taro-loader": "3.6.34",
    "@tarojs/webpack5-runner": "3.6.34",
    "@types/jest": "^29.3.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^18.15.11",
    "@types/qs": "^6.9.15",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "autoprefixer": "^10.4.19",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "3.6.34",
    "classnames": "^2.5.1",
    "eslint": "8.0.1",
    "eslint-config-taro": "^3.6.34",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.5.0",
    "postcss": "^8.4.40",
    "react-refresh": "^0.11.0",
    "stylelint": "^14.4.0",
    "tailwindcss": "^3.4.7",
